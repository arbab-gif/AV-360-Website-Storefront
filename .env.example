# Copy to `.env` and set ONE of these so "Request a Quote" reaches the AP360 team.

# Preferred: a URL that accepts a JSON POST (e.g. a Formspree form URL, or your own API).
VITE_QUOTE_ENDPOINT=

# Fallback: the team's inbox. The visitor's email app opens with the request filled in.
VITE_QUOTE_EMAIL=
